# Copy to .env, then replace ALL five CHANGE_ME values before Compose.
# Local demo only. Never put secrets into VITE_* variables.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
VITE_API_BASE_URL=
POSTGRES_USER=platform_admin
POSTGRES_DB=platform_admin
POSTGRES_PASSWORD=CHANGE_ME_admin
USER_DB_PASSWORD=CHANGE_ME_users
COURSE_DB_PASSWORD=CHANGE_ME_courses
QUIZ_DB_PASSWORD=CHANGE_ME_quizzes
PAYMENT_DB_PASSWORD=CHANGE_ME_payments
