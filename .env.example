# Safe local defaults. Set NGINX_BIND_ADDRESS=0.0.0.0 on a cloud VM and restrict
# inbound traffic with the instance firewall / Security Group.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HOST_PORT=8080
VITE_API_BASE_URL=
POSTGRES_USER=platform_admin
POSTGRES_DB=platform_admin
POSTGRES_PASSWORD=CHANGE_ME_generate_locally
USER_DB_PASSWORD=CHANGE_ME_generate_locally
COURSE_DB_PASSWORD=CHANGE_ME_generate_locally
QUIZ_DB_PASSWORD=CHANGE_ME_generate_locally
PAYMENT_DB_PASSWORD=CHANGE_ME_generate_locally
OELP_SECRET_DIR=.secrets
JWT_ISSUER=oelp-users
JWT_AUDIENCE=oelp
JWT_TTL_SECONDS=3600
PAYMENT_SERVICE_TOKEN=CHANGE_ME_generate_locally
QUIZ_SERVICE_TOKEN=CHANGE_ME_generate_locally
DEMO_MODE=true
SEED_DEMO=true
DEMO_LEARNER_EMAIL=learner@oelp.local
DEMO_LEARNER_PASSWORD=CHANGE_ME_generate_locally
DEMO_ADMIN_EMAIL=admin@oelp.local
DEMO_ADMIN_PASSWORD=CHANGE_ME_generate_locally
