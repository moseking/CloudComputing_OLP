# Generate a local .env and keys with scripts/setup_demo.py. All CHANGE_ME values must be replaced.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
VITE_API_BASE_URL=
POSTGRES_USER=platform_admin
POSTGRES_DB=platform_admin
POSTGRES_PASSWORD=CHANGE_ME_database_admin
USER_DB_PASSWORD=CHANGE_ME_users
COURSE_DB_PASSWORD=CHANGE_ME_courses
QUIZ_DB_PASSWORD=CHANGE_ME_quizzes
PAYMENT_DB_PASSWORD=CHANGE_ME_payments
OELP_SECRET_DIR=.secrets
JWT_ISSUER=oelp-users
JWT_AUDIENCE=oelp
JWT_TTL_SECONDS=3600
PAYMENT_SERVICE_TOKEN=CHANGE_ME_payment_to_course
QUIZ_SERVICE_TOKEN=CHANGE_ME_quiz_to_course
DEMO_MODE=true
SEED_DEMO=true
DEMO_LEARNER_EMAIL=learner@oelp.local
DEMO_LEARNER_PASSWORD=CHANGE_ME_unique_demo_learner
DEMO_ADMIN_EMAIL=admin@oelp.local
DEMO_ADMIN_PASSWORD=CHANGE_ME_unique_demo_admin
